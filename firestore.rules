rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{subcollection}/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /sharedDecks/{shareId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.resource.data.fromId == request.auth.uid
        && request.resource.data.toId != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] == request.resource.data.fromId
        && request.resource.data.participants[1] == request.resource.data.toId;
      allow update: if request.auth != null
        && request.resource.data.fromId == resource.data.fromId
        && request.resource.data.toId == resource.data.toId
        && request.resource.data.participants == resource.data.participants
        && (
          (resource.data.toId == request.auth.uid
            && request.resource.data.status in ["accepted", "rejected"])
          || (resource.data.fromId == request.auth.uid
            && resource.data.status == "pending"
            && request.resource.data.status == "pending")
        );
      allow delete: if request.auth != null
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    match /chatConversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && ((request.resource.data.get("type", "direct") == "direct"
              && request.resource.data.participants.size() == 2)
          || (request.resource.data.type == "group"
              && request.resource.data.createdBy == request.auth.uid
              && request.resource.data.participants.size() >= 3
              && request.resource.data.participants.size() <= 20));
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["updatedAt", "friendRequestId"]);
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["ciphertext", "iv", "messageType", "isUnsent", "updatedAt", "hiddenFor", "seenBy", "deliveredAt", "text", "attachments", "attachment"])
          && (
            (resource.data.senderId == request.auth.uid
              && resource.data.get("isUnsent", false) != true
              && request.resource.data.isUnsent == true
              && request.resource.data.text == "This message was unsent."
              && request.resource.data.get("attachments", []) == []
              && request.resource.data.get("attachment", null) == null
              && request.resource.data.get("hiddenFor", []) == resource.data.get("hiddenFor", []))
            || (request.resource.data.ciphertext == resource.data.ciphertext
              && request.resource.data.iv == resource.data.iv
              && request.resource.data.get("hiddenFor", []).hasAll(resource.data.get("hiddenFor", []))
              && request.resource.data.get("hiddenFor", []).size() == resource.data.get("hiddenFor", []).size() + 1
              && request.resource.data.get("hiddenFor", []).hasAny([request.auth.uid]))
            || (request.resource.data.ciphertext == resource.data.ciphertext
              && request.resource.data.iv == resource.data.iv
              && request.resource.data.get("hiddenFor", []) == resource.data.get("hiddenFor", [])
              && request.resource.data.seenBy.keys().hasAll(resource.data.get("seenBy", {}).keys()))
          );
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;
      }
    }
  }
}
